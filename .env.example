# ==========================================
# Tanque Cheio — Environment Variables
# ==========================================
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to git.
# ==========================================

# ------------------------------------------
# Database — Neon PostgreSQL
# ------------------------------------------
# Get from: https://console.neon.tech
# Use dev branch for local dev, main for production
DATABASE_URL="postgresql://user:password@ep-xyz.region.aws.neon.tech/tanquecheio?sslmode=require"

# ------------------------------------------
# Authentication — Clerk
# ------------------------------------------
# Get from: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# ------------------------------------------
# Cron Secret — Protect /api/sync endpoint
# ------------------------------------------
# Generate a random secret: openssl rand -hex 32
CRON_SECRET="your-cron-secret-here-change-this"

# ------------------------------------------
# Email — Resend
# ------------------------------------------
# Get from: https://resend.com
# Domain must be verified before emails will send
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="alertas@tanquecheio.pt"
ADMIN_EMAIL="admin@tanquecheio.pt"

# ------------------------------------------
# Forecast — EIA Open Data API (free key)
# ------------------------------------------
# Get from: https://www.eia.gov/opendata/
EIA_API_KEY="your-eia-api-key-here"

# ------------------------------------------
# Error Monitoring — Sentry
# ------------------------------------------
# Get from: https://sentry.io
SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"

# ------------------------------------------
# Analytics — Plausible
# ------------------------------------------
# Self-hosted or cloud instance domain
NEXT_PUBLIC_PLAUSIBLE_DOMAIN="tanquecheio.pt"

# ------------------------------------------
# V2 — EV Charging (not needed at launch)
# ------------------------------------------
# Get from: https://openchargemap.org
NEXT_PUBLIC_OPENCHARGE_API_KEY=""